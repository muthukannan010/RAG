VITE_API_BASE_URL=

VITE_HEALTH_ENDPOINT=/api/v1/health
VITE_DOCUMENTS_ENDPOINT=/api/v1/documents
VITE_UPLOAD_ENDPOINT=/api/v1/documents/upload
VITE_SEARCH_ENDPOINT=/api/v1/search

VITE_DELETE_ENDPOINT_TEMPLATE=/api/v1/documents/{id}
